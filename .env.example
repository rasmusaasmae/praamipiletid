# Database (Postgres connection string). Used by the API and the worker.
DATABASE_URL=postgres://ferry_tickets:ferry_tickets@localhost:5432/ferry_tickets

# Public base URL of the app. Sign-in callbacks are built from it. In
# development use the Vite dev server: http://localhost:5173
APP_URL=https://ferry-tickets.aasmae.com

# better-auth session signing secret (at least 32 characters).
BETTER_AUTH_SECRET=

# Pocket ID (OIDC). The OIDC client in Pocket ID needs:
#   Callback URL: https://ferry-tickets.aasmae.com/api/auth/callback/pocket-id
#   PKCE: on, Public client: off
#   Allowed user groups: ferry_tickets_users
POCKET_ID_URL=https://auth.aasmae.com
POCKET_ID_CLIENT_ID=
POCKET_ID_CLIENT_SECRET=

# AES-256-GCM key for encrypting captured praamid.ee logins at rest.
# 32 bytes as hex (64 chars): openssl rand -hex 32
PRAAMID_CRED_KEY=

# SMTP for the "ticket moved" email (worker). Proton Mail submission needs a
# paid plan with a custom domain; create an SMTP token under
# Settings → All settings → Mail → IMAP/SMTP → SMTP tokens.
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# How often the worker runs its cycle, in ms. Default 10000.
POLL_INTERVAL_MS=10000

# Optional Discord webhook for warn+ log lines. Unset: logs go to stdout only.
DISCORD_WEBHOOK_URL=

# Optional pino log level (trace|debug|info|warn|error|fatal|silent).
# Defaults: debug in development, info in production.
LOG_LEVEL=

# Tests only: a Postgres database the tests may empty at will.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ferry_tickets_test
