{
  "name": "ferry-tickets",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:api": "bun --filter @ferry-tickets/api dev",
    "dev:worker": "bun --filter @ferry-tickets/worker dev",
    "dev:web": "bun --filter @ferry-tickets/web dev",
    "build": "bun --filter @ferry-tickets/web build",
    "test": "bun test",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "db:generate": "bun --filter @ferry-tickets/db generate",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@types/bun": "1.3.12",
    "husky": "9.1.7",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "oxlint-tsgolint": "0.21.1",
    "typescript": "5.9.3"
  }
}
